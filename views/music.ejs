<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>好きな楽曲</title>
</head>
<body>
  <h2>好きな楽曲の一覧</h2>
  <table>
    <tr><th>ID</th><th>曲名</th><th>アーティスト</th><th>発売年</th></tr>
    <% for( let row of data ) { %>
      <tr><td><%= row.id %></td>
      <td><%= row.title %></td>
      <td><%= row.artist %></td>
      <td><%= row.year %></td></tr>
    <% } %>
  </table>
</body>
</html>
